{
  "name": "grapesjs-mjml",
  "version": "1.1.1-rc.0",
  "description": "MJML Componenets integration in GrapesJS",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "release:core": "node --experimental-strip-types --experimental-default-type=module scripts/release.ts latest",
    "release:rc": "node --experimental-strip-types --experimental-default-type=module scripts/release.ts rc",
    "build": "grapesjs-cli build --patch=false",
    "start": "grapesjs-cli serve",
    "test": "jest",
    "test:bundle": "jest --runInBand --testMatch '<rootDir>/tests/bundle.test.ts'",
    "typecheck": "tsc --noEmit --project tests/tsconfig.json"
  },
  "files": [
    "/dist",
    "/locale"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GrapesJS/mjml.git"
  },
  "keywords": [
    "grapesjs",
    "plugin",
    "mjml",
    "wysiwyg"
  ],
  "author": "Artur Arseniev",
  "license": "BSD-3-Clause",
  "dependencies": {
    "@types/mjml-core": "^4.15.2"
  },
  "overrides": {
    "grapesjs-cli": {
      "dts-bundle-generator": "^9.5.1"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "babel-jest": "^30.5.2",
    "buffer": "6.0.3",
    "eslint": "^10.13.0",
    "grapesjs": "^0.23.8",
    "grapesjs-cli": "^4.1.3",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "mjml-core": "4.18.0",
    "mjml-preset-core": "4.18.0",
    "mjml-validator": "4.18.0",
    "path-browserify": "1.0.1",
    "process": "0.11.10",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^5.9.3",
    "url": "0.11.4"
  }
}
